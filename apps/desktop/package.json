{
  "name": "qualirec-desktop",
  "version": "1.0.0",
  "description": "QualiRec - Recruiter Qualification Platform (Desktop)",
  "author": "QualiRec",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build:prisma": "prisma generate --schema=prisma/schema.prisma && cp -r node_modules/.prisma/client/* ../../node_modules/.prisma/client/ 2>/dev/null || true",
    "build:schema-sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script | sed 's/CREATE TABLE/CREATE TABLE IF NOT EXISTS/g; s/CREATE UNIQUE INDEX/CREATE UNIQUE INDEX IF NOT EXISTS/g' > prisma/init.sql",
    "build:api": "tsc -p tsconfig.main.json",
    "build:web": "cd ../web && npx vite build --outDir=../desktop/dist/web --emptyOutDir",
    "build:all": "npm run build:prisma && npm run build:schema-sql && npm run build:api && npm run build:web",
    "start": "electron dist/main.js",
    "dev": "npm run build:all && electron dist/main.js",
    "pack": "npm run build:all && electron-builder --dir",
    "dist": "npm run build:all && electron-builder",
    "dist:mac": "npm run build:all && electron-builder --mac",
    "start:web": "node dist/start-web.js",
    "dev:web": "npm run build:all && node dist/start-web.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "better-sqlite3": "^11.6.0",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "electron": "33.4.11",
    "electron-builder": "^25.1.0",
    "prisma": "^5.20.0",
    "typescript": "^5.4.0"
  },
  "build": {
    "appId": "com.qualirec.desktop",
    "productName": "QualiRec",
    "copyright": "Copyright © 2026 QualiRec",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ],
      "hardenedRuntime": true,
      "darkModeSupport": true
    },
    "files": [
      "dist/**/*",
      "prisma/**/*",
      "node_modules/**/*",
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": ["**/*", "!**/*debian*", "!**/*rhel*", "!**/*musl*"]
      },
      "!node_modules/.cache",
      "!node_modules/@qualirec/shared",
      "!node_modules/@prisma/engines"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/.prisma/**/*.node",
      "prisma/**/*"
    ]
  }
}
