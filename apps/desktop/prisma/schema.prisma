generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "darwin-arm64", "darwin"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite doesn't support enums, so we use String fields

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          String    @default("RECRUITER")
  preferences   String    @default("{}")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  templates          Template[]
  callSessions       CallSession[]
  integrationConfigs IntegrationConfig[]
  auditLogs          AuditLog[]

  @@map("users")
}

model Template {
  id          String   @id @default(uuid())
  name        String
  type        String
  description String   @default("")
  sections    String   @default("[]")
  version     Int      @default(1)
  isDefault   Boolean  @default(false)
  isArchived  Boolean  @default(false)
  isDraft     Boolean  @default(false)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  callSessions CallSession[]

  @@map("templates")
}

model CallSession {
  id              String   @id @default(uuid())
  recruiterId     String
  recruiter       User     @relation(fields: [recruiterId], references: [id])
  templateId      String
  template        Template @relation(fields: [templateId], references: [id])
  templateVersion Int      @default(1)
  templateSnapshot String?
  contactType     String
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  crmContactId    String?
  voipAdapter     String   @default("manual")
  voipCallId      String?
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  duration        Int?
  status          String   @default("IN_PROGRESS")
  floatingNotes   String?
  summary         String?
  crmSyncStatus   String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  answers     SessionAnswer[]
  crmSyncLogs CrmSyncLog[]

  @@map("call_sessions")
}

model SessionAnswer {
  id            String   @id @default(uuid())
  sessionId     String
  session       CallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId    String
  responseValue String?
  notes         String?
  status        String   @default("ANSWERED")
  answeredAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([sessionId, questionId])
  @@map("session_answers")
}

model CrmSyncLog {
  id           String   @id @default(uuid())
  sessionId    String
  session      CallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  adapter      String
  status       String   @default("PENDING")
  payload      String?
  response     String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("crm_sync_logs")
}

model IntegrationConfig {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  adapterType String
  adapterName String
  credentials String   @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, adapterType, adapterName])
  @@map("integration_configs")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  diff       String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model CrmContact {
  id         String   @id @default(uuid())
  externalId String?
  firstName  String
  lastName   String
  email      String?
  phone      String?
  company    String?
  title      String?
  source     String   @default("manual")
  fields     String   @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notes      CrmContactNote[]
  activities CrmContactActivity[]
  tasks      CrmContactTask[]

  @@map("crm_contacts")
}

model CrmContactNote {
  id        String     @id @default(uuid())
  contactId String
  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title     String
  body      String
  metadata  String?
  createdAt DateTime   @default(now())

  @@map("crm_contact_notes")
}

model CrmContactActivity {
  id          String     @id @default(uuid())
  contactId   String
  contact     CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String
  duration    Int?
  date        DateTime
  metadata    String?
  createdAt   DateTime   @default(now())

  @@map("crm_contact_activities")
}

model CrmContactTask {
  id          String     @id @default(uuid())
  contactId   String
  contact     CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title       String
  description String
  dueDate     DateTime?
  priority    String     @default("MEDIUM")
  isCompleted Boolean    @default(false)
  assigneeId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("crm_contact_tasks")
}
